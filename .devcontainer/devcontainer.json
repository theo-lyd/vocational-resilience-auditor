{
  "name": "vocational-resilience-auditor",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt && pip install -e .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "innoverio.vscode-dbt-power-user"
      ]
    }
  },
  "remoteEnv": {
    "LC_ALL": "de_DE.UTF-8",
    "LANG": "de_DE.UTF-8"
  }
}
